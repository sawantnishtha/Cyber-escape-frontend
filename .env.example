# Supabase Configuration
# Replace with your project details from Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Mode Configuration
# If VITE_DEMO_MODE=true or Supabase keys are empty, Cyber Escape operates in fully functional
# multi-tab simulator mode using BroadcastChannel / LocalStorage state sync.
VITE_DEMO_MODE=true

# Game Master / Admin Secret Key for quick validation fallback
VITE_DEFAULT_ADMIN_KEY=ADMIN-CYBER-2026
